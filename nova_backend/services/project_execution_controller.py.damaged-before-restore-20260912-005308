    def _finalize_nested_steps(
        self,
        task,
        result=None,
    ):
        """
        Keep nested step state consistent with the parent task.

        A completed parent task cannot retain active, waiting, or blocked
        nested steps.
        """
        if not isinstance(task, dict):
            return

        steps = task.get("steps")

        if not isinstance(steps, list):
            return

        final_result = result

        if final_result is None:
            final_result = (
                task.get("result")
                or task.get("content")
                or "Step completed."
            )

        for step in steps:
            if not isinstance(step, dict):
                continue

            step_status = str(
                step.get("status") or ""
            ).strip().lower()

            completion_status = str(
                step.get("completion_status") or ""
            ).strip().lower()

            if (
                step_status in {
                    "active",
                    "running",
                    "open",
                    "pending",
                    "waiting",
                }
                or completion_status in {
                    "active",
                    "running",
                    "waiting",
                    "pending",
                }
            ):
                step["status"] = "completed"
                step["completion_status"] = "completed"
                step["waiting"] = False
                step["blocked"] = False
                step["error"] = None

                if not step.get("result"):
                    step["result"] = final_result

                step["completed_at"] = (
                    step.get("completed_at")
                    or task.get("completed_at")
                )

    def _runnable_tasks(
        self,
        tasks,
    ):
        """
        Return tasks that are eligible for execution.

        A task is runnable when:

        - it is not already terminal
        - all declared dependencies resolve to completed tasks

        Dependencies may reference tasks by:
        - UUID
        - exact title
        - normalized title
        - planner-generated slug
        """

        import re

        if not isinstance(
            tasks,
            list,
        ):
            return []

        terminal_statuses = {
            "completed",
            "complete",
            "success",
            "succeeded",
            "done",
            "failed",
            "error",
            "cancelled",
            "canceled",
            "skipped",
        }

        completed_statuses = {
            "completed",
            "complete",
            "success",
            "succeeded",
            "done",
        }

        # Normalize parent task status from nested execution steps.
        # A task cannot remain completed while any nested step is active,
        # waiting, blocked, pending, or otherwise incomplete.
        for task in tasks:
            if not isinstance(
                task,
                dict,
            ):
                continue

            task_steps = task.get("steps")

            if not isinstance(
                task_steps,
                list,
            ):
                continue

            normalized_step_statuses = [
                str(
                    step.get("status")
                    or ""
                ).strip().lower()
                for step in task_steps
                if isinstance(
                    step,
                    dict,
                )
            ]

            if not normalized_step_statuses:
                continue

            has_incomplete_step = any(
                status not in completed_statuses
                for status in normalized_step_statuses
            )

            if has_incomplete_step:
                task["status"] = "pending"

                for step in task_steps:
                    if not isinstance(
                        step,
                        dict,
                    ):
                        continue

                    step_status = str(
                        step.get("status")
                        or ""
                    ).strip().lower()

                    if step_status in {
                        "active",
                        "running",
                        "in_progress",
                        "processing",
                    }:
                        step["waiting"] = False
                        step["blocked"] = False

        print(
            "[PROJECT TASK STATUS NORMALIZED]",
            [
                {
                    "task_id": str(
                        task.get("id")
                        or ""
                    ),
                    "status": task.get("status"),
                    "step_statuses": [
                        step.get("status")
                        for step in (
                            task.get("steps")
                            or []
                        )
                        if isinstance(
                            step,
                            dict,
                        )
                    ],
                }
                for task in tasks
                if isinstance(
                    task,
                    dict,
                )
            ],
            flush=True,
        )

        task_by_id = {}
        task_by_title = {}
        task_by_normalized_title = {}
        task_by_slug = {}

        for task in tasks:
            if not isinstance(
                task,
                dict,
            ):
                continue

            task_id = str(
                task.get("id")
                or ""
            ).strip()

            task_title = str(
                task.get("title")
                or ""
            ).strip()

            normalized_title = re.sub(
                r"[^a-z0-9]+",
                " ",
                task_title.lower(),
            ).strip()

            slug = re.sub(
                r"[^a-z0-9]+",
                "-",
                task_title.lower(),
            ).strip("-")

            if task_id:
                task_by_id[task_id] = task

            if task_title:
                task_by_title[task_title.lower()] = task

            if normalized_title:
                task_by_normalized_title[
                    normalized_title
                ] = task

            if slug:
                task_by_slug[slug] = task

        runnable = []

        for task in tasks:
            if not isinstance(
                task,
                dict,
            ):
                continue

            task_id = str(
                task.get("id")
                or ""
            ).strip()

            task_title = str(
                task.get("title")
                or ""
            ).strip()

            task_status = str(
                task.get("status")
                or ""
            ).strip().lower()

            if task_status in terminal_statuses:
                print(
                    "[PROJECT RUNNABLE SKIP TERMINAL]",
                    {
                        "task_id": task_id,
                        "task_title": task_title,
                        "status": task_status,
                    },
                    flush=True,
                )
                continue

            dependencies = task.get("dependencies")

            if dependencies is None:
                dependencies = []

            if isinstance(
                dependencies,
                str,
            ):
                dependency_values = [
                    dependencies
                ]
            elif isinstance(
                dependencies,
                list,
            ):
                dependency_values = dependencies
            else:
                dependency_values = []

            dependencies_satisfied = True

            for dependency_value in dependency_values:
                dependency_text = str(
                    dependency_value
                    or ""
                ).strip()

                if not dependency_text:
                    continue

                dependency_task = task_by_id.get(
                    dependency_text
                )

                if dependency_task is None:
                    dependency_task = task_by_title.get(
                        dependency_text.lower()
                    )

                if dependency_task is None:
                    normalized_dependency = re.sub(
                        r"[^a-z0-9]+",
                        " ",
                        dependency_text.lower(),
                    ).strip()

                    dependency_task = (
                        task_by_normalized_title.get(
                            normalized_dependency
                        )
                    )

                if dependency_task is None:
                    dependency_slug = re.sub(
                        r"[^a-z0-9]+",
                        "-",
                        dependency_text.lower(),
                    ).strip("-")

                    dependency_task = task_by_slug.get(
                        dependency_slug
                    )

                if dependency_task is None:
                    dependencies_satisfied = False

                    print(
                        "[PROJECT RUNNABLE INPUT]",
                        {
                            "task_id": task_id,
                            "task_title": task_title,
                            "dependency": dependency_value,
                            "reason": "dependency_not_found",
                        },
                        flush=True,
                    )

                    break

                dependency_status = str(
                    dependency_task.get("status")
                    or ""
                ).strip().lower()

                if dependency_status not in completed_statuses:
                    dependencies_satisfied = False

                    print(
                        "[PROJECT RUNNABLE INPUT]",
                        {
                            "task_id": task_id,
                            "task_title": task_title,
                            "dependency": dependency_value,
                            "dependency_task_id": str(
                                dependency_task.get("id")
                                or ""
                            ),
                            "dependency_status": dependency_status,
                            "reason": "dependency_not_completed",
                        },
                        flush=True,
                    )

                    break

            if dependencies_satisfied:
                runnable.append(
                    task
                )

        print(
            "[PROJECT RUNNABLE OUTPUT]",
            {
                "runnable_count": len(runnable),
                "runnable": [
                    {
                        "id": task.get("id"),
                        "title": task.get("title"),
                        "status": task.get("status"),
                        "dependencies": task.get("dependencies"),
                    }
                    for task in runnable
                    if isinstance(
                        task,
                        dict,
                    )
                ],
            },
            flush=True,
        )

        return runnable

    def _get_execution_service(self):
        return self.chat_execution_service

    def _build_execution_steps(
        self,
        tasks,
    ):
        steps = []

        if not isinstance(
            tasks,
            list,
        ):
            return steps

        execution_fields = (
            "execution_mode",
            "dependencies",
            "expected_output",
            "completion_criteria",
            "target_file",
            "target_files",
            "target_function",
            "content",
            "code",
            "replacement",
            "command",
        )

        for task in tasks:
            if not isinstance(
                task,
                dict,
            ):
                continue

            task_id = task.get(
                "id"
            )

            if not task_id:
                continue

            task_id = str(task_id)

            task_title = str(
                task.get(
                    "title",
                    "Project task",
                )
                or "Project task"
            ).strip()

            task_description = str(
                task.get(
                    "description",
                    "",
                )
                or ""
            ).strip()

            persisted_steps = task.get(
                "steps"
            )

            if isinstance(
                persisted_steps,
                list,
            ) and persisted_steps:

                for step_index, raw_step in enumerate(
                    persisted_steps
                ):
                    if not isinstance(
                        raw_step,
                        dict,
                    ):
                        continue

                    step_id = str(
                        raw_step.get(
                            "id"
                        )
                        or f"{task_id}_step_{step_index + 1}"
                    )

                    step_title = str(
                        raw_step.get(
                            "title",
                            f"Step {step_index + 1}",
                        )
                        or f"Step {step_index + 1}"
                    ).strip()

                    step_description = str(
                        raw_step.get(
                            "description",
                            "",
                        )
                        or ""
                    ).strip()

                    step_action = self._normalize_task_action(
                        raw_step.get(
                            "action",
                            task.get(
                                "action",
                                "analysis",
                            ),
                        )
                    )

                    step = {
                        "id": step_id,
                        "task_id": task_id,
                        "task_title": task_title,
                        "title": step_title or f"Step {step_index + 1}",
                        "description": (
                            step_description
                            or task_description
                        ),
                        "action": step_action,
                        "status": str(
                            raw_step.get(
                                "status",
                                "pending",
                            )
                            or "pending"
                        ).strip().lower(),
                    }

                    for field_name in execution_fields:
                        value = raw_step.get(
                            field_name
                        )

                        if value in (
                            None,
                            "",
                            [],
                        ):
                            value = task.get(
                                field_name
                            )

                        if value not in (
                            None,
                            "",
                            [],
                        ):
                            step[field_name] = value

                    for field_name in (
                        "expected_output",
                        "completion_criteria",
                        "result",
                        "error",
                        "next_action",
                        "completion_status",
                        "waiting",
                    ):
                        if field_name in raw_step:
                            step[field_name] = raw_step.get(
                                field_name
                            )

                    steps.append(
                        step
                    )

                continue

            title = task_title or "Project task"

            action = self._normalize_task_action(
                task.get(
                    "action",
                    "analysis",
                )
            )

            step = {
                "id": f"project_task_{task_id}",
                "task_id": task_id,
                "task_title": title,
                "title": title,
                "description": task_description,
                "action": action,
                "status": "pending",
            }

            for field_name in execution_fields:
                value = task.get(
                    field_name
                )

                if value not in (
                    None,
                    "",
                    [],
                ):
                    step[field_name] = value

            steps.append(
                step
            )

        return steps

    def _execute_with_existing_orchestrator(
        self,
        project_id,
        tasks,
        command,
    ):
        execution_service = (
            self._get_execution_service()
        )

        if execution_service is None:
            return {
                "ok": False,
                "error": (
                    "The existing execution service "
                    "is unavailable."
                ),
            }

        steps = self._build_execution_steps(
            tasks
        )

        if not steps:
            return {
                "ok": True,
                "execution": {},
                "message": "No runnable project tasks remain.",
            }

        task_ids = [
            str(
                task.get(
                    "id"
                )
            )
            for task in tasks
            if isinstance(
                task,
                dict,
            )
            and task.get(
                "id"
            )
        ]

        task_key = (
            task_ids[0]
            if task_ids
            else command
        )

        session_id = (
            f"project:{project_id}:{task_key}"
        )

        project = self._get_project(
            project_id
        ) or {}

        goal = project.get(
            "name",
            "Project execution",
        )

        context = {
            "project_id": project_id,
            "task_type": "project_execution",
            "command": command,
        }

        try:
            print(
                "[PROJECT EXECUTION] starting",
                {
                    "session_id": session_id,
                    "command": command,
                    "goal": goal,
                    "step_count": len(steps),
                },
                flush=True,
            )

            execution_service.start(
                session_id=session_id,
                goal=goal,
                steps=steps,
                context=context,
            )

            print(
                "[PROJECT EXECUTION] start completed",
                session_id,
                flush=True,
            )

            if command == "run_all":
                print(
                    "[PROJECT EXECUTION] calling run_all",
                    session_id,
                    flush=True,
                )

                execution = execution_service.run_all(
                    session_id=session_id
                )

                print(
                    "[PROJECT EXECUTION] run_all returned",
                    type(execution),
                    flush=True,
                )
            else:
                print(
                    "[PROJECT EXECUTION] calling advance",
                    session_id,
                    flush=True,
                )

                execution = execution_service.advance(
                    session_id=session_id
                )

                print(
                    "[PROJECT EXECUTION] advance returned",
                    type(execution),
                    flush=True,
                )

            print(
                "[PROJECT EXECUTION RAW RESULT]",
                execution,
                flush=True,
            )

        except Exception as exc:
            import traceback

            print(
                "[PROJECT EXECUTION ERROR]",
                repr(exc),
                flush=True,
            )

            traceback.print_exc()

            return {
                "ok": False,
                "error": (
                    "Project execution failed: "
                    f"{type(exc).__name__}: {exc}"
                ),
            }

        if not isinstance(
            execution,
            dict,
        ):
            return {
                "ok": False,
                "error": (
                    "The execution service "
                    "returned no result."
                ),
            }

        return {
            "ok": True,
            "execution": execution,
            "assistant_message": {
                "role": "assistant",
                "text": (
                    execution_service.format_reply(
                        execution
                    )
                ),
            },
        }

