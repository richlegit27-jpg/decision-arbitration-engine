    def reset_project(
        self,
        project_id,
    ):
        project = self._get_project(
            project_id
        )

        if not project:
            return None

        tasks = project.get("tasks")

        if not isinstance(
            tasks,
            list,
        ):
            tasks = []

        now = self._now()

        for task in tasks:
            if not isinstance(
                task,
                dict,
            ):
                continue

            task["status"] = "pending"
            task.pop("error", None)
            task.pop("result", None)
            task.pop("output", None)
            task.pop("started_at", None)
            task.pop("completed_at", None)
            task.pop("failed_at", None)
            task.pop("blocked_by", None)

            steps = task.get("steps")

            if isinstance(
                steps,
                list,
            ):
                for step in steps:
                    if not isinstance(
                        step,
                        dict,
                    ):
                        continue

                    step["status"] = "open"
                    step.pop("error", None)
                    step.pop("result", None)
                    step.pop("output", None)
                    step.pop("started_at", None)
                    step.pop("completed_at", None)
                    step.pop("failed_at", None)
                    step.pop("blocked_by", None)

            task["current_step_index"] = 0
            task["current_step_id"] = (
                steps[0].get("id")
                if isinstance(steps, list)
                and steps
                and isinstance(steps[0], dict)
                else None
            )

        project["tasks"] = tasks

        phases = project.get("phases")

        if isinstance(
            phases,
            list,
        ):
            for phase in phases:
                if not isinstance(
                    phase,
                    dict,
                ):
                    continue

                phase["status"] = "planned"
                phase["updated_at"] = now

        execution = project.get("execution")

        if not isinstance(
            execution,
            dict,
        ):
            execution = {}

        execution.update(
            {
                "completed_steps": [],
                "completed_tasks": [],
                "current_phase_id": None,
                "current_phase_title": None,
                "current_step": "",
                "current_step_index": None,
                "current_task_id": None,
                "failed_tasks": [],
                "last_action": "reset",
                "phase_queue": [],
                "queue": [],
                "status": "idle",
                "updated_at": now,
            }
        )

        project["execution"] = execution
        project["status"] = "active"
        project["active"] = True
        project["updated_at"] = now

        projects = (
            self.project_workspace_service._load_projects()
        )

        for project_record in projects:
            if project_record.get("id") == project_id:
                project_record.clear()
                project_record.update(project)
                break

        self.project_workspace_service._save_projects(
            projects
        )

        self.project_workspace_service.update_execution_state(
            project_id,
            status="idle",
            current_task_id=None,
            current_step="",
            queue=[],
            last_action="reset",
        )

        return {
            "project_id": project_id,
            "status": "active",
            "action": "reset",
            "message": "Project execution reset.",
            "execution": execution,
        }

    def _next_step(
        self,
        project_id,
    ):
        result = self.continue_project(
            project_id
        )

        if not isinstance(
            result,
            dict,
        ):
            return result

        if result.get("ok") is False:
            return result

        result["action"] = "next_step"
        result["message"] = (
            "Next execution step completed."
        )

        execution = result.get(
            "execution"
        )

        if isinstance(
            execution,
            dict,
        ):
            execution["last_action"] = (
                "next_step"
            )

        return result

    def _next_task(
        self,
        project_id,
    ):
        project = self._get_project(
            project_id
        )

        if not project:
            return {
                "ok": False,
                "project_id": project_id,
                "action": "next_task",
                "message": "Project not found.",
            }

        tasks = self._get_tasks(
            project
        )

        runnable = self._phase_aware_runnable_tasks(
            project,
            tasks,
        )

        execution = (
            self.project_workspace_service
            .get_execution_state(
                project_id
            )
            or {}
        )

        current_task_id = execution.get(
            "current_task_id"
        )

        current_index = -1

        if current_task_id:
            for index, task in enumerate(
                runnable
            ):
                if not isinstance(
                    task,
                    dict,
                ):
                    continue

                if str(
                    task.get("id")
                ) == str(
                    current_task_id
                ):
                    current_index = index
                    break

        next_task = None

        if current_index >= 0:
            for task in runnable[
                current_index + 1:
            ]:
                if not isinstance(
                    task,
                    dict,
                ):
                    continue

                next_task = task
                break
        else:
            for task in runnable:
                if not isinstance(
                    task,
                    dict,
                ):
                    continue

                next_task = task
                break

        if next_task:
            queue = [
                task.get("id")
                for task in runnable
                if isinstance(
                    task,
                    dict,
                )
                and task.get("id")
            ]

            execution = (
                self.project_workspace_service
                .update_execution_state(
                    project_id,
                    status="paused",
                    current_task_id=(
                        next_task.get("id")
                    ),
                    current_step=(
                        next_task.get(
                            "title",
                            "Next task",
                        )
                    ),
                    queue=queue,
                    last_action="next_task",
                )
            )

            return {
                "ok": True,
                "project_id": project_id,
                "action": "next_task",
                "message": (
                    "Advanced to the next runnable task. "
                    "Execution is paused."
                ),
                "execution": execution,
            }

        execution = (
            self.project_workspace_service
            .get_execution_state(
                project_id
            )
            or {}
        )

        execution["last_action"] = (
            "next_task"
        )

        return {
            "ok": True,
            "project_id": project_id,
            "action": "next_task",
            "message": (
                "No next runnable task remains."
            ),
            "execution": execution,
        }

