    def _phase_aware_runnable_tasks(
        self,
        project,
        tasks,
    ):
        if not isinstance(
            tasks,
            list,
        ):
            return []

        phases = (
            project.get(
                "phases",
                [],
            )
            if isinstance(
                project,
                dict,
            )
            else []
        )

        if not isinstance(
            phases,
            list,
        ) or not phases:
            return self._runnable_tasks(
                tasks
            )

        normalized_phases = [
            phase
            for phase in phases
            if isinstance(
                phase,
                dict,
            )
            and phase.get("id") is not None
        ]

        if not normalized_phases:
            return self._runnable_tasks(
                tasks
            )

        normalized_phases.sort(
            key=lambda phase: (
                phase.get(
                    "order",
                    0,
                ),
                str(
                    phase.get(
                        "id",
                        "",
                    )
                ),
            )
        )

        terminal_statuses = {
            "completed",
            "complete",
            "done",
            "success",
            "cancelled",
            "canceled",
        }

        for phase in normalized_phases:
            phase_id = str(
                phase.get(
                    "id",
                )
            )

            phase_tasks = [
                task
                for task in tasks
                if isinstance(
                    task,
                    dict,
                )
                and str(
                    task.get(
                        "phase_id",
                        "",
                    )
                ) == phase_id
            ]

            if not phase_tasks:
                continue

            unfinished_phase_tasks = [
                task
                for task in phase_tasks
                if str(
                    task.get(
                        "status",
                        "open",
                    )
                ).strip().lower()
                not in terminal_statuses
            ]

            if not unfinished_phase_tasks:
                continue

            all_runnable_tasks = self._runnable_tasks(
                tasks
            )

            phase_task_ids = {
                str(
                    task.get(
                        "id",
                        "",
                    )
                ).strip()
                for task in unfinished_phase_tasks
                if isinstance(
                    task,
                    dict,
                )
            }

            phase_runnable = [
                task
                for task in all_runnable_tasks
                if str(
                    task.get(
                        "id",
                        "",
                    )
                ).strip()
                in phase_task_ids
            ]

            print(
                "[PROJECT PHASE RUNNABLE]",
                {
                    "phase_id": phase_id,
                    "phase_title": phase.get(
                        "title",
                        "",
                    ),
                    "phase_tasks": len(
                        phase_tasks
                    ),
                    "unfinished": len(
                        unfinished_phase_tasks
                    ),
                    "runnable": len(
                        phase_runnable
                    ),
                },
                flush=True,
            )

            return phase_runnable

        # All defined phases are complete. Unassigned tasks may now run.
        unassigned_tasks = [
            task
            for task in tasks
            if isinstance(
                task,
                dict,
            )
            and not str(
                task.get(
                    "phase_id",
                    "",
                )
                or ""
            ).strip()
        ]

        return self._runnable_tasks(
            unassigned_tasks
        )

    def _sync_phase_statuses(
        self,
        project_id,
    ):
        project = self._get_project(
            project_id
        )

        if not isinstance(
            project,
            dict,
        ):
            return None

        phases = project.get(
            "phases",
            [],
        )

        tasks = project.get(
            "tasks",
            [],
        )

        if not isinstance(
            phases,
            list,
        ):
            return project

        if not isinstance(
            tasks,
            list,
        ):
            tasks = []

        tasks_by_phase = {}

        for task in tasks:
            if not isinstance(
                task,
                dict,
            ):
                continue

            phase_id = task.get(
                "phase_id"
            )

            if not phase_id:
                continue

            phase_id = str(
                phase_id
            )

            tasks_by_phase.setdefault(
                phase_id,
                [],
            ).append(task)

        phase_updates = []

        for phase in phases:
            if not isinstance(
                phase,
                dict,
            ):
                continue

            phase_id = phase.get(
                "id"
            )

            if not phase_id:
                continue

            phase_id = str(
                phase_id
            )

            phase_tasks = tasks_by_phase.get(
                phase_id,
                [],
            )

            if not phase_tasks:
                continue

            statuses = {
                str(
                    task.get(
                        "status",
                        "pending",
                    )
                ).strip().lower()
                for task in phase_tasks
            }

            if statuses & {
                "failed",
                "error",
            }:
                next_status = "failed"

            elif statuses and statuses <= {
                "completed",
                "complete",
                "done",
            }:
                next_status = "completed"

            elif statuses & {
                "running",
                "active",
                "in_progress",
                "in-progress",
            }:
                next_status = "active"

            else:
                next_status = "planned"

            current_status = str(
                phase.get(
                    "status",
                    "planned",
                )
            ).strip().lower()

            if current_status == next_status:
                continue

            updated_phase = (
                self.project_workspace_service.update_phase(
                    project_id,
                    phase_id,
                    {
                        "status": next_status,
                    },
                )
            )

            phase_updates.append(
                {
                    "phase_id": phase_id,
                    "previous_status": current_status,
                    "status": next_status,
                    "updated": updated_phase is not None,
                }
            )

        if phase_updates:
            print(
                "[PROJECT PHASE STATUS SYNC]",
                {
                    "project_id": project_id,
                    "updates": phase_updates,
                },
                flush=True,
            )

        return self._get_project(
            project_id
        )

    def continue_project(
        self,
        project_id,
    ):
        project = self._get_project(
            project_id
        )

        if not project:
            return None

        tasks = self._get_tasks(
            project
        )

        print(
            "[PROJECT CONTINUE TASKS BEFORE FILTER]",
            [
                {
                    "id": task.get("id"),
                    "title": task.get("title"),
                    "status": task.get("status"),
                    "dependencies": task.get(
                        "dependencies",
                        [],
                    ),
                }
                for task in tasks
                if isinstance(
                    task,
                    dict,
                )
            ],
            flush=True,
        )

        runnable = self._phase_aware_runnable_tasks(
            project,
            tasks,
        )

        # No currently runnable task does NOT automatically
        # mean the project is complete.
        #
        # First determine whether there are unfinished tasks.
        unfinished_tasks = [
            task
            for task in tasks
            if isinstance(
                task,
                dict,
            )
            and str(
                task.get(
                    "status",
                    "open",
                )
            ).strip().lower()
            not in {
                "completed",
                "complete",
                "done",
                "success",
                "cancelled",
                "canceled",
            }
        ]

        failed_tasks = [
            task
            for task in tasks
            if isinstance(
                task,
                dict,
            )
            and str(
                task.get(
                    "status",
                    "",
                )
                or ""
            ).strip().lower()
            in {
                "failed",
                "error",
            }
        ]

        if failed_tasks:
            failed_task = failed_tasks[0]

            failed_task_id = str(
                failed_task.get("id")
                or ""
            ).strip()

            failed_task_title = str(
                failed_task.get("title")
                or "Failed task"
            ).strip()

            failure_reason = str(
                failed_task.get("error")
                or failed_task.get("result")
                or failed_task.get("content")
                or "Task execution failed."
            )

            self.project_workspace_service.update_execution_state(
                project_id,
                status="failed",
                current_task_id=failed_task_id or None,
                current_step=failed_task_title,
                queue=[],
                last_action="run_all",
            )

            projects = (
                self.project_workspace_service._load_projects()
            )

            for project_record in projects:
                if project_record.get("id") != project_id:
                    continue

                project_record["status"] = "failed"
                project_record["active"] = False
                project_record["updated_at"] = (
                    datetime.now(
                        timezone.utc
                    ).isoformat()
                )

                self.project_workspace_service._save_projects(
                    projects
                )
                break

            last_result = {
                "ok": False,
                "status": "failed",
                "task_id": failed_task_id,
                "task_title": failed_task_title,
                "error": failure_reason,
                "message": (
                    f"Project execution stopped because "
                    f"task '{failed_task_title}' failed."
                ),
            }

            return last_result

        if not runnable:
            task_statuses = {
                str(
                    task.get(
                        "status",
                        "",
                    )
                ).strip().lower()
                for task in tasks
                if isinstance(
                    task,
                    dict,
                )
            }

            if "failed" in task_statuses:
                final_status = "failed"
                message = (
                    "Project execution ended with "
                    "failed tasks."
                )

            elif "blocked" in task_statuses:
                final_status = "blocked"
                message = (
                    "Project execution is blocked."
                )

            elif unfinished_tasks:
                # There is still project work remaining, but
                # none is currently runnable. Do NOT report
                # completion.
                queue = [
                    task.get("id")
                    for task in unfinished_tasks
                    if task.get("id")
                ]

                next_task = (
                    unfinished_tasks[0]
                    if unfinished_tasks
                    else None
                )

                print(
                    "[PROJECT CONTINUE WAITING]",
                    {
                        "project_id": project_id,
                        "unfinished": len(
                            unfinished_tasks
                        ),
                        "queue": queue,
                    },
                    flush=True,
                )

                execution = (
                    self.project_workspace_service
                    .update_execution_state(
                        project_id,
                        status="paused",
                        current_task_id=(
                            next_task.get("id")
                            if next_task
                            else None
                        ),
                        current_step=(
                            next_task.get(
                                "title",
                                "",
                            )
                            if next_task
                            else ""
                        ),
                        queue=queue,
                        last_action="continue",
                    )
                )

                return {
                    "project_id": project_id,
                    "action": "continue",
                    "execution": execution,
                    "message": (
                        "Project has unfinished tasks "
                        "that are currently waiting on "
                        "dependencies."
                    ),
                }

            else:
                final_status = "completed"
                message = (
                    "Project completed successfully."
                )

            execution = (
                self.project_workspace_service
                .update_execution_state(
                    project_id,
                    status=final_status,
                    current_task_id=None,
                    current_step=None,
                    queue=[],
                    last_action="continue",
                )
            )

            return {
                "project_id": project_id,
                "action": "continue",
                "execution": execution,
                "message": message,
            }

        project_execution = (
            self.project_workspace_service
            .get_execution_state(
                project_id
            )
            or {}
        )

        current_task_id = (
            project_execution.get(
                "current_task_id"
            )
        )

        runnable_by_id = {
            task.get("id"): task
            for task in runnable
            if isinstance(
                task,
                dict,
            )
            and task.get("id")
        }

        current_task = runnable_by_id.get(
            current_task_id
        )

        if current_task is None:
            current_task = runnable[0]

        current_task_id = (
            current_task.get("id")
        )

        queue = [
            task.get("id")
            for task in runnable
            if isinstance(
                task,
                dict,
            )
            and task.get("id")
        ]

        self.project_workspace_service.update_execution_state(
            project_id,
            status="running",
            current_task_id=current_task_id,
            current_step=current_task.get(
                "title",
                "Current task",
            ),
            queue=queue,
            last_action="continue",
        )

        self._materialize_task_files(
            [current_task]
        )

        result = self._execute_with_existing_orchestrator(
            project_id=project_id,
            tasks=[current_task],
            command="run_step",
        )

        self._sync_project_execution(
            project_id,
            result,
            "continue",
        )

        published_artifacts = (
            self._publish_completed_artifacts(
                project_id,
                [current_task],
                result,
            )
        )

        return {
            "project_id": project_id,
            "action": "continue",
            "artifacts": published_artifacts,
            "execution": (
                self.project_workspace_service
                .get_execution_state(
                    project_id
                )
            ),
            "message": (
                result.get(
                    "assistant_message",
                    {},
                ).get(
                    "text",
                    "Project execution continued.",
                )
                if isinstance(
                    result,
                    dict,
                )
                else "Project execution continued."
            ),
        }

    def run_all(
        self,
        project_id,
    ):

        import inspect

        print(
            "[PROJECT RUN-ALL MODULE]",
            __file__,
            flush=True,
        )

        print(
            "[PROJECT RUN-ALL METHOD]",
            inspect.getsourcefile(
                self.run_all
            ),
            flush=True,
        )

        print(
            "[PROJECT RUN-ALL INSTANCE]",
            id(self),
            flush=True,
        )

        execution = {
            "status": "completed",
            "steps": [],
            "artifacts": [],
            "assistant_message": {
                "text": "Project execution completed.",
            },
        }

        artifacts = []
        cycles = 0
        loop_guard = 0

        project = self._get_project(
            project_id
        )

        if not project:
            return None

        all_published_artifacts = []
        last_result = None
        loop_guard = 0
        max_loops = 100

        while loop_guard < max_loops:
            loop_guard += 1

            project = self._get_project(
                project_id
            )

            if not project:
                break

            tasks = self._get_tasks(
                project
            )

            runnable = self._phase_aware_runnable_tasks(
                project,
                tasks,
            )

            print(
                "[PROJECT RUN-ALL LOOP]",
                loop_guard,
                "RUNNABLE:",
                len(runnable),
                flush=True,
            )

            if not runnable:
                # No runnable tasks means the project is either fully
                # complete or blocked/waiting. Resolve the terminal state
                # here instead of bypassing final-status persistence.
                task_statuses = {
                    str(
                        task.get(
                            "status",
                            "",
                        )
                    ).strip().lower()
                    for task in tasks
                    if isinstance(
                        task,
                        dict,
                    )
                }

                terminal_success_statuses = {
                    "completed",
                    "complete",
                    "done",
                    "success",
                }

                if task_statuses and task_statuses.issubset(
                    terminal_success_statuses
                ):
                    self._sync_phase_statuses(
                        project_id
                    )

                    self.project_workspace_service.update_execution_state(
                        project_id,
                        status="completed",
                        current_task_id=None,
                        current_step="",
                        queue=[],
                        last_action="run_all",
                    )

                    projects = (
                        self.project_workspace_service._load_projects()
                    )

                    for project_record in projects:
                        if project_record.get("id") != project_id:
                            continue

                        project_record["status"] = "completed"
                        project_record["active"] = False
                        project_record["updated_at"] = datetime.now(
                            timezone.utc
                        ).isoformat()

                        self.project_workspace_service._save_projects(
                            projects
                        )
                        break

                    last_result = {
                        "status": "completed",
                        "message": "Project execution completed.",
                    }

                break

            queue = [
                task.get("id")
                for task in runnable
                if task.get("id")
            ]

            current_task = runnable[0]

            print(
                "[PROJECT RUN-ALL BEFORE STATE UPDATE]",
                flush=True,
            )

            self.project_workspace_service.update_execution_state(
                project_id,
                status="running",
                current_task_id=current_task.get(
                    "id"
                ),
                current_step=current_task.get(
                    "title",
                    "Current task",
                ),
                queue=queue,
                last_action="run_all",
            )

            print(
                "[PROJECT RUN-ALL EXECUTING TASK]",
                current_task.get("id"),
                current_task.get("title"),
                flush=True,
            )

            self._materialize_task_files(
                [current_task]
            )

            print(
                "[PROJECT CONTINUE BEFORE EXECUTION]",
                {
                    "project_id": project_id,
                    "task_id": current_task.get("id"),
                    "task_title": current_task.get("title"),
                    "task_status": current_task.get("status"),
                    "action": current_task.get("action"),
                    "command": current_task.get("command"),
                    "payload": current_task.get("payload"),
                    "execution_mode": current_task.get("execution_mode"),
                },
                flush=True,
            )

            execution_failed = False
            execution_error = None

            try:
                result = self._execute_with_existing_orchestrator(
                    project_id=project_id,
                    tasks=[current_task],
                    command="run_step",
                )

                print(
                    "[PROJECT RUN-ALL RESULT CLASSIFICATION]",
                    {
                        "task_id": current_task.get("id"),
                        "task_status_before_result": current_task.get(
                            "status"
                        ),
                        "result_type": type(result).__name__,
                        "result_ok": (
                            result.get("ok")
                            if isinstance(result, dict)
                            else None
                        ),
                        "result_status": (
                            result.get("status")
                            if isinstance(result, dict)
                            else None
                        ),
                        "result_error": (
                            result.get("error")
                            if isinstance(result, dict)
                            else None
                        ),
                        "execution": (
                            result.get("execution")
                            if isinstance(result, dict)
                            else None
                        ),
                    },
                    flush=True,
                )

                print(
                    "[PROJECT RUN-ALL ORCHESTRATOR RESULT]",
                    {
                        "result_type": type(result).__name__,
                        "result": result,
                    },
                    flush=True,
                )

            except Exception as exc:
                execution_failed = True
                execution_error = (
                    f"{type(exc).__name__}: {exc}"
                )

                print(
                    "[PROJECT RUN-ALL EXECUTION ERROR]",
                    execution_error,
                    flush=True,
                )

                current_task["status"] = "failed"
                current_task["error"] = execution_error

                try:
                    self.project_workspace_service.update_task_status(
                        project_id,
                        current_task.get("id"),
                        "failed",
                    )
                except Exception as persist_exc:
                    print(
                        "[PROJECT RUN-ALL TASK FAILURE PERSIST ERROR]",
                        repr(persist_exc),
                        flush=True,
                    )

                try:
                    self.project_workspace_service.update_execution_state(
                        project_id,
                        status="failed",
                        current_task_id=current_task.get("id"),
                        current_step=current_task.get(
                            "title",
                            "Current task",
                        ),
                        queue=queue,
                        last_action="run_all",
                    )
                except Exception as state_exc:
                    print(
                        "[PROJECT RUN-ALL STATE FAILURE PERSIST ERROR]",
                        repr(state_exc),
                        flush=True,
                    )

                result = {
                    "ok": False,
                    "status": "failed",
                    "error": execution_error,
                    "execution": {
                        "status": "failed",
                        "error": execution_error,
                    },
                }

            if execution_failed:
                failed_task_id = current_task.get("id")
                failed_task_title = current_task.get(
                    "title",
                    "Current task",
                )
                failure_reason = execution_error or (
                    "Task execution failed."
                )

                last_result = {
                    "ok": False,
                    "status": "failed",
                    "task_id": failed_task_id,
                    "task_title": failed_task_title,
                    "error": failure_reason,
                    "message": (
                        f"Project execution stopped because "
                        f"task '{failed_task_title}' failed."
                    ),
                }


            print(
                "[PROJECT CONTINUE AFTER EXECUTION]",
                {
                    "project_id": project_id,
                    "task_id": current_task.get("id"),
                    "task_title": current_task.get("title"),
                    "task_status": current_task.get("status"),
                    "execution": (
                        result.get("execution")
                        or result.get("execution_state")
                        or {}
                    )
                    if isinstance(result, dict)
                    else result,
                    "result": result,
                },
                flush=True,
            )

            print(
                "[PROJECT RUN-ALL TASK RESULT]",
                current_task.get("id"),
                type(result),
                repr(result),
                flush=True,
            )

            refreshed_after_execution = self._get_project(
                project_id
            )

            refreshed_tasks_after_execution = (
                self._get_tasks(
                    refreshed_after_execution
                )
                if refreshed_after_execution
                else []
            )

            executed_task = next(
                (
                    task
                    for task in refreshed_tasks_after_execution
                    if isinstance(task, dict)
                    and str(task.get("id"))
                    == str(current_task.get("id"))
                ),
                None,
            )

            if executed_task:
                current_task = executed_task

            if result is None and executed_task:
                result = {
                    "execution": {
                        "steps": [
                            dict(executed_task)
                        ]
                    }
                }

            last_result = result

            print(
                "[PROJECT RUN-ALL RESULT DATA]",
                result,
                flush=True,
            )

            # Re-read the persisted project state after execution.
            # The handler may have blocked a task because dependencies
            # remain unresolved, even if the raw result reports failure.
            try:
                refreshed_project = self._get_project(
                    project_id
                )

                refreshed_tasks = self._get_tasks(
                    refreshed_project
                )

                execution_state = (
                    refreshed_project.get(
                        "execution_state"
                    )
                    or {}
                )

                waiting_on_dependencies = any(
                    isinstance(task, dict)
                    and (
                        str(
                            task.get("status", "")
                            or ""
                        ).strip().lower()
                        == "waiting"
                        or bool(
                            task.get("waiting")
                        )
                        or bool(
                            task.get(
                                "unresolved_dependencies"
                            )
                        )
                    )
                    for task in refreshed_tasks
                )

                persisted_waiting = (
                    str(
                        execution_state.get(
                            "status",
                            "",
                        )
                        or ""
                    ).strip().lower()
                    == "waiting"
                    or bool(
                        execution_state.get(
                            "waiting"
                        )
                    )
                )

                if (
                    waiting_on_dependencies
                    or persisted_waiting
                ):
                    waiting_error = (
                        "Execution is waiting for unresolved "
                        "task dependencies."
                    )

                    try:
                        self.project_workspace_service.update_execution_state(
                            project_id,
                            status="waiting",
                            waiting=True,
                            complete=False,
                            error=waiting_error,
                            current_task_id=None,
                            current_step="",
                            queue=[],
                            last_action="run_all",
                        )
                    except Exception as state_exc:
                        print(
                            "[PROJECT RUN-ALL WAITING STATE FAILURE]",
                            repr(state_exc),
                            flush=True,
                        )

                    last_result = {
                        "ok": True,
                        "status": "waiting",
                        "project_id": project_id,
                        "action": "run_all",
                        "waiting": True,
                        "complete": False,
                        "error": waiting_error,
                        "message": (
                            "Project execution is waiting for "
                            "unresolved task dependencies."
                        ),
                        "execution": {
                            "status": "waiting",
                            "waiting": True,
                            "complete": False,
                            "error": waiting_error,
                        },
                    }

                    break

            except Exception as waiting_check_exc:
                print(
                    "[PROJECT RUN-ALL WAITING CHECK FAILURE]",
                    repr(waiting_check_exc),
                    flush=True,
                )

            if (
                isinstance(result, dict)
                and result.get("ok") is False
                and not (
                    bool(
                        result.get(
                            "waiting"
                        )
                    )
                    or str(
                        result.get(
                            "status",
                            "",
                        )
                        or ""
                    ).strip().lower()
                    == "waiting"
                    or bool(
                        isinstance(
                            result.get(
                                "execution"
                            ),
                            dict,
                        )
                        and (
                            result.get(
                                "execution"
                            ).get(
                                "waiting"
                            )
                            or str(
                                result.get(
                                    "execution"
                                ).get(
                                    "status",
                                    "",
                                )
                                or ""
                            ).strip().lower()
                            == "waiting"
                        )
                    )
                )
            ):

                failed_task_id = current_task.get("id")
                failed_task_title = current_task.get(
                    "title",
                    "Current task",
                )
                failure_reason = str(
                    result.get("error")
                    or result.get("message")
                    or "Task execution failed."
                )

                current_task["status"] = "failed"
                current_task["error"] = failure_reason

                try:
                    self.project_workspace_service.update_task_status(
                        project_id,
                        failed_task_id,
                        "failed",
                    )
                except Exception as persist_exc:
                    print(
                        "[PROJECT RUN-ALL RESULT FAILURE PERSIST ERROR]",
                        repr(persist_exc),
                        flush=True,
                    )

                try:
                    self.project_workspace_service.update_execution_state(
                        project_id,
                        status="failed",
                        current_task_id=failed_task_id,
                        current_step=failed_task_title,
                        queue=queue,
                        last_action="run_all",
                    )
                except Exception as state_exc:
                    print(
                        "[PROJECT RUN-ALL RESULT STATE FAILURE PERSIST ERROR]",
                        repr(state_exc),
                        flush=True,
                    )

                last_result = {
                    "ok": False,
                    "status": "failed",
                    "task_id": failed_task_id,
                    "task_title": failed_task_title,
                    "error": failure_reason,
                    "message": (
                        f"Project execution stopped because "
                        f"task '{failed_task_title}' failed."
                    ),
                }

                print(
                    "[PROJECT RUN-ALL RESULT FAILURE]",
                    last_result,
                    flush=True,
                )

                try:
                    self._sync_phase_statuses(project_id)
                except Exception as phase_sync_error:
                    print(
                        "[PROJECT RUN-ALL PHASE STATUS SYNC ERROR]",
                        repr(phase_sync_error),
                        flush=True,
                    )

                # Persist the top-level project terminal state
                # immediately when a task failure stops run_all.
                projects = (
                    self.project_workspace_service._load_projects()
                )

                for project_record in projects:
                    if project_record.get("id") != project_id:
                        continue

                    project_record["status"] = "failed"
                    project_record["active"] = False
                    project_record["updated_at"] = (
                        datetime.now(
                            timezone.utc
                        ).isoformat()
                    )

                    self.project_workspace_service._save_projects(
                        projects
                    )
                    break

                break

            print(
                "[PROJECT RUN-ALL EXECUTED TASK STATE]",
                executed_task,
                flush=True,
            )

            try:
                tasks = self._merge_execution_results_into_tasks(
                    refreshed_tasks_after_execution
                    or tasks,
                    result,
                )

                persisted_tasks = (
                    self.project_workspace_service.update_project_tasks(
                        project_id,
                        tasks,
                    )
                )

                if persisted_tasks is not None:
                    tasks = persisted_tasks

                print(
                    "[PROJECT RUN-ALL TASKS PERSISTED]",
                    [
                        {
                            "id": task.get("id"),
                            "status": task.get("status"),
                        }
                        for task in tasks
                        if isinstance(task, dict)
                    ],
                    flush=True,
                )

                executed_task = next(
                    (
                        task
                        for task in tasks
                        if isinstance(task, dict)
                        and str(
                            task.get("id")
                            or ""
                        ).strip()
                        == str(
                            current_task.get("id")
                            or ""
                        ).strip()
                    ),
                    current_task,
                )

                executed_task_status = str(
                    executed_task.get(
                        "status",
                        "",
                    )
                    or ""
                ).strip().lower()

                if executed_task_status in {
                    "failed",
                    "error",
                }:
                    failed_task_id = str(
                        executed_task.get("id")
                        or ""
                    ).strip()

                    failed_task_title = str(
                        executed_task.get("title")
                        or "Previous task"
                    ).strip()

                    failure_reason = (
                        executed_task.get("error")
                        or executed_task.get("result")
                        or executed_task.get("content")
                        or "Task execution failed."
                    )

                    executed_task["status"] = "failed"
                    executed_task["error"] = str(
                        failure_reason
                    )

                    try:
                        self.project_workspace_service.update_task_status(
                            project_id,
                            executed_task.get("id"),
                            "failed",
                        )
                    except Exception as persist_exc:
                        print(
                            "[PROJECT RUN-ALL FAILED TASK PERSIST ERROR]",
                            repr(persist_exc),
                            flush=True,
                        )

                    refreshed_project_after_failure = (
                        self._get_project(
                            project_id
                        )
                    )

                    refreshed_tasks_after_failure = (
                        self._get_tasks(
                            refreshed_project_after_failure
                        )
                        if refreshed_project_after_failure
                        else tasks
                    )

                    failed_task_index = -1

                    for index, task in enumerate(
                        refreshed_tasks_after_failure
                    ):
                        if not isinstance(
                            task,
                            dict,
                        ):
                            continue

                        if str(
                            task.get("id")
                            or ""
                        ).strip() == failed_task_id:
                            failed_task_index = index
                            break

                    if failed_task_index >= 0:
                        for downstream_task in (
                            refreshed_tasks_after_failure[
                                failed_task_index + 1:
                            ]
                        ):
                            if not isinstance(
                                downstream_task,
                                dict,
                            ):
                                continue

                            downstream_status = str(
                                downstream_task.get(
                                    "status",
                                    "",
                                )
                                or ""
                            ).strip().lower()

                            if downstream_status in {
                                "completed",
                                "complete",
                                "done",
                                "success",
                                "failed",
                                "error",
                                "cancelled",
                                "canceled",
                                "blocked",
                            }:
                                continue

                            downstream_task_id = (
                                downstream_task.get("id")
                            )

                            downstream_task["status"] = "blocked"
                            downstream_task["blocked_by"] = failed_task_id
                            downstream_task["error"] = (
                                f"Blocked because prerequisite task "
                                f"'{failed_task_title}' "
                                f"({failed_task_id}) failed."
                            )

                            persisted_blocked_task = (
                                self.project_workspace_service.update_task_status(
                                    project_id,
                                    downstream_task_id,
                                    "blocked",
                                )
                            )

                            if persisted_blocked_task is None:
                                print(
                                    "[PROJECT RUN-ALL BLOCKED TASK PERSIST RETURNED NONE]",
                                    {
                                        "project_id": project_id,
                                        "task_id": downstream_task_id,
                                        "task_title": downstream_task.get(
                                            "title"
                                        ),
                                        "failed_task_id": failed_task_id,
                                    },
                                    flush=True,
                                )
                            else:
                                persisted_blocked_task["blocked_by"] = (
                                    failed_task_id
                                )
                                persisted_blocked_task["error"] = (
                                    downstream_task["error"]
                                )

                                print(
                                    "[PROJECT RUN-ALL BLOCKED TASK PERSISTED]",
                                    {
                                        "task_id": downstream_task_id,
                                        "blocked_by": failed_task_id,
                                    },
                                    flush=True,
                                )

                            try:
                                persisted_blocked_task = (
                                    self.project_workspace_service.update_task_status(
                                        project_id,
                                        downstream_task_id,
                                        "blocked",
                                    )
                                )

                                if persisted_blocked_task is None:
                                    print(
                                        "[PROJECT RUN-ALL BLOCKED TASK PERSIST RETURNED NONE]",
                                        {
                                            "project_id": project_id,
                                            "task_id": downstream_task_id,
                                            "task_title": downstream_task.get(
                                                "title"
                                            ),
                                            "failed_task_id": failed_task_id,
                                            "all_task_ids": [
                                                task.get("id")
                                                for task in refreshed_tasks_after_failure
                                                if isinstance(task, dict)
                                            ],
                                        },
                                        flush=True,
                                    )

                            except Exception as persist_exc:
                                print(
                                    "[PROJECT RUN-ALL BLOCKED TASK PERSIST ERROR]",
                                    {
                                        "project_id": project_id,
                                        "task_id": downstream_task_id,
                                        "task_title": downstream_task.get(
                                            "title"
                                        ),
                                        "failed_task_id": failed_task_id,
                                        "error": repr(
                                            persist_exc
                                        ),
                                    },
                                    flush=True,
                                )
                                print(
                                    "[PROJECT RUN-ALL BLOCKED TASK PERSIST ERROR]",
                                    {
                                        "task_id": downstream_task_id,
                                        "error": repr(
                                            persist_exc
                                        ),
                                    },
                                    flush=True,
                                )

                        tasks = refreshed_tasks_after_failure

                published_artifacts = (
                    self._publish_completed_artifacts(
                        project_id,
                        [current_task],
                        result,
                    )
                )

                if published_artifacts:
                    all_published_artifacts.extend(
                        published_artifacts
                    )

                self._sync_project_execution(
                    project_id,
                    result,
                    "run_all",
                    tasks=tasks,
                )

                self._sync_phase_statuses(
                    project_id
                )

            except Exception as exc:
                error_text = (
                    f"{type(exc).__name__}: {exc}"
                )

                print(
                    "[PROJECT RUN-ALL POST-EXECUTION ERROR]",
                    error_text,
                    flush=True,
                )

                last_result = {
                    "ok": False,
                    "error": error_text,
                    "execution": (
                        result.get("execution")
                        or result.get("execution_state")
                        or {}
                    )
                    if isinstance(result, dict)
                    else {},
                    "steps": (
                        result.get("steps", [])
                        if isinstance(result, dict)
                        else []
                    ),
                    "task_id": current_task.get("id"),
                    "task_title": current_task.get("title"),
                }

                current_task["status"] = "failed"
                current_task["error"] = error_text

                try:
                    self.project_workspace_service.update_task_status(
                        project_id,
                        current_task.get("id"),
                        "failed",
                    )
                except Exception as persist_exc:
                    print(
                        "[PROJECT RUN-ALL TASK FAILURE PERSIST ERROR]",
                        repr(persist_exc),
                        flush=True,
                    )

                try:
                    self.project_workspace_service.update_execution_state(
                        project_id,
                        status="failed",
                        current_task_id=current_task.get("id"),
                        current_step=current_task.get(
                            "title",
                            "Current task",
                        ),
                        queue=queue,
                        last_action="run_all",
                    )
                except Exception as state_exc:
                    print(
                        "[PROJECT RUN-ALL STATE FAILURE PERSIST ERROR]",
                        repr(state_exc),
                        flush=True,
                    )

                break

            refreshed_project = self._get_project(
                project_id
            )

            if not refreshed_project:
                break

            refreshed_tasks = self._get_tasks(
                refreshed_project
            )

            refreshed_runnable = self._phase_aware_runnable_tasks(
                refreshed_project,
                refreshed_tasks,
            )

            execution = (
                self.project_workspace_service
                .get_execution_state(
                    project_id
                )
                or {}
            )

            execution_status = str(
                execution.get(
                    "status",
                    "",
                )
            ).strip().lower()

            print(
                "[PROJECT RUN-ALL AFTER TASK]",
                "STATUS:",
                execution_status,
                "REMAINING:",
                len(refreshed_runnable),
                flush=True,
            )

            if execution_status in {
                "failed",
                "blocked",
                "paused",
                "stopped",
            }:
                break

            if not refreshed_runnable:
                refreshed_tasks = self._get_tasks(
                    refreshed_project
                )

                waiting_on_dependencies = any(
                    isinstance(task, dict)
                    and (
                        str(
                            task.get("status", "")
                            or ""
                        ).strip().lower()
                        == "waiting"
                        or bool(
                            task.get("waiting")
                        )
                        or bool(
                            task.get(
                                "unresolved_dependencies"
                            )
                        )
                    )
                    for task in refreshed_tasks
                )

                if waiting_on_dependencies:
                    execution_status = "waiting"

                    try:
                        self.project_workspace_service.update_execution_state(
                            project_id,
                            status="waiting",
                            waiting=True,
                            complete=False,
                            error=(
                                "Execution is waiting for unresolved "
                                "task dependencies."
                            ),
                        )
                    except Exception as state_exc:
                        print(
                            "[PROJECT RUN-ALL WAITING STATE FAILURE]",
                            repr(state_exc),
                            flush=True,
                        )

                break

            current_task_id = current_task.get(
                "id"
            )

            next_task_ids = {
                task.get("id")
                for task in refreshed_runnable
                if task.get("id")
            }

            if current_task_id in next_task_ids:
                print(
                    "[PROJECT RUN-ALL NO PROGRESS]",
                    current_task_id,
                    flush=True,
                )

                break

        final_project = self._get_project(
            project_id
        )

        final_tasks = (
            self._get_tasks(final_project)
            if final_project
            else []
        )

        remaining = self._phase_aware_runnable_tasks(
            final_project,
            final_tasks,
        )

        final_task_statuses = {
            str(
                task.get(
                    "status",
                    "",
                )
            ).strip().lower()
            for task in final_tasks
            if isinstance(
                task,
                dict,
            )
        }

        terminal_success_statuses = {
            "completed",
            "complete",
            "done",
            "success",
        }

        all_tasks_completed = bool(
            final_task_statuses
        ) and all(
            status in terminal_success_statuses
            for status in final_task_statuses
        )

        if "failed" in final_task_statuses:
            final_status = "failed"

        elif "blocked" in final_task_statuses:
            final_status = "blocked"

        elif (
            "waiting_approval"
            in final_task_statuses
        ):
            final_status = "paused"

        elif all_tasks_completed:
            final_status = "completed"

        elif remaining:
            final_status = "running"

        else:
            final_status = "paused"

        if final_status == "completed":
            final_execution = (
                self.project_workspace_service
                .update_execution_state(
                    project_id,
                    status="completed",
                    current_task_id=None,
                    current_step="",
                    queue=[],
                    last_action="run_all",
                )
            )

            self._sync_phase_statuses(
                project_id
            )

            # Persist the top-level project terminal state.
            projects = (
                self.project_workspace_service._load_projects()
            )

            for project in projects:
                if project.get("id") != project_id:
                    continue

                project["status"] = final_status
                project["active"] = False
                project["updated_at"] = (
                    datetime.now(
                        timezone.utc
                    ).isoformat()
                )

                self.project_workspace_service._save_projects(
                    projects
                )

                print(
                    "[PROJECT TOP-LEVEL STATUS PERSISTED]",
                    {
                        "project_id": project_id,
                        "status": project["status"],
                        "active": project["active"],
                    },
                    flush=True,
                )

                break

        elif final_status in {
            "failed",
            "blocked",
            "paused",
        }:
            final_execution = (
                self.project_workspace_service
                .update_execution_state(
                    project_id,
                    status=final_status,
                    current_task_id=None,
                    current_step="",
                    queue=[],
                    last_action="run_all",
                )
            )

            # Persist the top-level project terminal state.
            projects = (
                self.project_workspace_service._load_projects()
            )

            for project in projects:
                if project.get("id") != project_id:
                    continue

                project["status"] = final_status
                project["active"] = False
                project["updated_at"] = (
                    datetime.now(
                        timezone.utc
                    ).isoformat()
                )

                self.project_workspace_service._save_projects(
                    projects
                )

                print(
                    "[PROJECT TOP-LEVEL STATUS PERSISTED]",
                    {
                        "project_id": project_id,
                        "status": project["status"],
                        "active": project["active"],
                    },
                    flush=True,
                )

                break

        else:
            next_task = remaining[0]

            final_execution = (
                self.project_workspace_service
                .update_execution_state(
                    project_id,
                    status="running",
                    current_task_id=next_task.get(
                        "id"
                    ),
                    current_step=next_task.get(
                        "title",
                        "",
                    ),
                    queue=[
                        task.get("id")
                        for task in remaining
                        if task.get("id")
                    ],
                    last_action="run_all",
                )
            )

        message = (
            last_result.get(
                "assistant_message",
                {},
            ).get(
                "text",
                "Project execution completed.",
            )
            if isinstance(
                last_result,
                dict,
            )
            else "Project execution completed."
        )

        if not remaining:
            message = (
                "Project execution completed. "
                f"Processed {loop_guard} task cycle(s)."
            )

        refreshed_project = self._get_project(project_id)

        if isinstance(refreshed_project, dict):
            refreshed_tasks = refreshed_project.get("tasks", [])
            if isinstance(refreshed_tasks, list):
                tasks = refreshed_tasks

        failed_tasks = [
            task
            for task in tasks
            if str(task.get("status", "")).strip().lower()
            in {"failed", "error"}
        ]

        blocked_tasks = [
            task
            for task in tasks
            if str(task.get("status", "")).strip().lower()
            in {"blocked", "waiting"}
        ]

        remaining = [
            task
            for task in tasks
            if str(task.get("status", "")).strip().lower()
            not in {
                "completed",
                "complete",
                "done",
                "failed",
                "error",
            }
        ]

        waiting_on_dependencies = any(
            isinstance(task, dict)
            and (
                str(
                    task.get("status", "")
                    or ""
                ).strip().lower()
                in {
                    "waiting",
                    "blocked",
                }
                or bool(
                    task.get("waiting")
                )
                or bool(
                    task.get(
                        "unresolved_dependencies"
                    )
                )
            )
            for task in tasks
        )

        completed_statuses = {
            "completed",
            "complete",
            "success",
            "succeeded",
            "done",
        }

        execution_state = (
            self.project_workspace_service.get_execution_state(
                project_id
            )
            or {}
        )

        if not isinstance(execution_state, dict):
            execution_state = {}

        persisted_execution_status = str(
            execution_state.get("status")
            or ""
        ).strip().lower()

        persisted_execution_complete = (
            execution_state.get("complete") is True
        )

        persisted_execution_steps = (
            execution_state.get("steps")
            or []
        )

        if not isinstance(
            persisted_execution_steps,
            list,
        ):
            persisted_execution_steps = []

        persisted_step_statuses = [
            str(
                step.get("status")
                or step.get("completion_status")
                or ""
            ).strip().lower()
            for step in persisted_execution_steps
            if isinstance(
                step,
                dict,
            )
        ]

        all_persisted_steps_completed = (
            bool(persisted_step_statuses)
            and all(
                status in completed_statuses
                for status in persisted_step_statuses
            )
        )

        execution_is_complete = (
            persisted_execution_complete
            and persisted_execution_status
            in completed_statuses
            and all_persisted_steps_completed
        )

        print(
            "[PROJECT RUN-ALL FINAL COMPLETION CHECK]",
            {
                "project_id": project_id,
                "persisted_execution_status":
                    persisted_execution_status,
                "persisted_execution_complete":
                    persisted_execution_complete,
                "persisted_step_statuses":
                    persisted_step_statuses,
                "all_persisted_steps_completed":
                    all_persisted_steps_completed,
                "execution_is_complete":
                    execution_is_complete,
                "waiting_on_dependencies":
                    waiting_on_dependencies,
                "failed_tasks":
                    len(failed_tasks),
                "blocked_tasks":
                    len(blocked_tasks),
                "remaining_tasks":
                    len(remaining),
            },
            flush=True,
        )

        if waiting_on_dependencies:
            execution_status = "waiting"
        elif failed_tasks:
            execution_status = "failed"
        elif blocked_tasks:
            execution_status = "blocked"
        elif execution_is_complete:
            execution_status = "completed"
        else:
            execution_status = "in_progress"

        execution = {
            "status": execution_status,
            "assistant_message": {
                "text": (
                    "Project execution failed because a task failed."
                    if execution_status == "failed"
                    else (
                        "Project execution is blocked because unfinished "
                        "tasks are waiting on dependencies."
                        if execution_status == "blocked"
                        else (
                            "Project execution is waiting for dependencies."
                            if execution_status in {
                                "waiting",
                                "paused",
                            }
                            else (
                                "Project execution completed."
                                if execution_status == "completed"
                                else "Project execution remains in progress."
                            )
                        )
                    )
                )
            },
        }

        response_ok = execution_status not in {
            "failed",
            "error",
        }

        if execution_status == "failed":
            response_message = (
                f"Project execution stopped because "
                f"a task failed. Processed "
                f"{loop_guard} task cycle(s)."
            )

        elif execution_status == "blocked":
            response_message = (
                f"Project execution is blocked. "
                f"Processed {loop_guard} task cycle(s)."
            )

        elif execution_status in {
            "waiting",
            "paused",
        }:
            response_message = (
                f"Project execution is waiting for "
                f"dependencies. Processed "
                f"{loop_guard} task cycle(s)."
            )

        elif execution_status == "completed":
            response_message = (
                f"Project execution completed. "
                f"Processed {loop_guard} task cycle(s)."
            )

        else:
            response_message = (
                f"Project execution remains in progress. "
                f"Processed {loop_guard} task cycle(s)."
            )

        return {
            "ok": response_ok,
            "status": execution_status,
            "project_id": project_id,
            "action": "run_all",
            "message": response_message,
            "execution": execution,
            "artifacts": artifacts,
            "debug_last_result": last_result,
        }
    def _merge_execution_results_into_tasks(
        self,
        tasks,
        result,
    ):
        if not isinstance(
            tasks,
            list,
        ):
            return tasks

        if not isinstance(
            result,
            dict,
        ):
            return tasks

        execution = (
            result.get("execution")
            or result.get("execution_state")
            or {}
        )

        if not isinstance(
            execution,
            dict,
        ):
            execution = result

        execution_steps = execution.get(
            "steps"
        ) or []

        if not isinstance(
            execution_steps,
            list,
        ):
            execution_steps = []

        steps_by_task_id = {}

        for step in execution_steps:
            if not isinstance(
                step,
                dict,
            ):
                continue

            task_id = (
                step.get("task_id")
                or step.get("parent_task_id")
            )

            if not task_id:
                step_id = str(
                    step.get("id")
                    or ""
                )

                if step_id.startswith(
                    "project_task_"
                ):
                    task_id = step_id.replace(
                        "project_task_",
                        "",
                        1,
                    )

            if not task_id:
                continue

            task_key = str(
                task_id
            )

            steps_by_task_id.setdefault(
                task_key,
                [],
            ).append(
                step
            )

        execution_status = str(
            execution.get("status")
            or ""
        ).strip().lower()

        completed_statuses = {
            "completed",
            "complete",
            "done",
            "success",
            "succeeded",
        }

        execution_step_statuses = [
            str(
                step.get("status")
                or step.get("state")
                or step.get("completion_status")
                or ""
            ).strip().lower()
            for step in execution_steps
            if isinstance(
                step,
                dict,
            )
        ]

        all_execution_steps_completed = (
            bool(execution_step_statuses)
            and all(
                status in completed_statuses
                for status in execution_step_statuses
            )
        )

        execution_complete = (
            (
                execution.get("complete") is True
                or execution_status in completed_statuses
            )
            and all_execution_steps_completed
        )
        execution_error = (
            execution.get("error")
            or execution.get("message")
            or ""
        )

        completed_statuses = {
            "completed",
            "complete",
            "done",
            "success",
        }

        failed_statuses = {
            "failed",
            "failure",
            "error",
            "errored",
            "exception",
        }

        blocked_statuses = {
            "blocked",
            "cancelled",
            "canceled",
        }

        waiting_statuses = {
            "waiting",
            "paused",
            "needs_input",
            "needs input",
            "approval_required",
            "waiting_approval",
        }

        for task in tasks:
            if not isinstance(
                task,
                dict,
            ):
                continue

            task_id = task.get(
                "id"
            )

            if not task_id:
                continue

            task_key = str(
                task_id
            )

            task_steps = steps_by_task_id.get(
                task_key,
                [],
            )

            if not task_steps:
                continue

            persisted_steps = task.get(
                "steps"
            )

            if not isinstance(
                persisted_steps,
                list,
            ):
                persisted_steps = []

            persisted_by_id = {}

            for index, persisted_step in enumerate(
                persisted_steps
            ):
                if not isinstance(
                    persisted_step,
                    dict,
                ):
                    continue

                persisted_id = str(
                    persisted_step.get(
                        "id"
                    )
                    or f"{task_key}_step_{index + 1}"
                )

                persisted_by_id[
                    persisted_id
                ] = persisted_step

            task_outputs = []
            task_has_failure = False
            task_has_block = False
            task_has_waiting = False
            task_all_completed = True

            for execution_step in task_steps:
                step_id = str(
                    execution_step.get(
                        "id"
                    )
                    or ""
                )

                step_status = str(
                    execution_step.get(
                        "status"
                    )
                    or execution_step.get(
                        "state"
                    )
                    or ""
                ).strip().lower()

                step_output = (
                    execution_step.get("result")
                    or execution_step.get("output")
                    or execution_step.get("content")
                    or execution_step.get("text")
                    or ""
                )

                if step_output:
                    task_outputs.append(
                        str(step_output)
                    )

                if step_status in failed_statuses:
                    task_has_failure = True

                elif step_status in blocked_statuses:
                    task_has_block = True

                elif step_status in waiting_statuses:
                    task_has_waiting = True

                elif step_status not in completed_statuses:
                    task_all_completed = False

                if persisted_by_id:
                    persisted_step = persisted_by_id.get(
                        step_id
                    )

                    if isinstance(
                        persisted_step,
                        dict,
                    ):
                        persisted_step.update(
                            execution_step
                        )

            if persisted_steps:
                task["steps"] = persisted_steps

            synchronized_steps = []

            for index, execution_step in enumerate(
                task_steps
            ):
                if not isinstance(
                    execution_step,
                    dict,
                ):
                    continue

                step_id = str(
                    execution_step.get(
                        "id"
                    )
                    or f"{task_key}_step_{index + 1}"
                )

                persisted_step = persisted_by_id.get(
                    step_id
                )

                if isinstance(
                    persisted_step,
                    dict,
                ):
                    persisted_step.update(
                        execution_step
                    )
                    synchronized_steps.append(
                        persisted_step
                    )
                else:
                    synchronized_steps.append(
                        dict(execution_step)
                    )

            persisted_steps = synchronized_steps
            task["steps"] = persisted_steps
            task_steps = persisted_steps

            persisted_by_id = {}

            for persisted_step in persisted_steps:
                if not isinstance(
                    persisted_step,
                    dict,
                ):
                    continue

                persisted_id = str(
                    persisted_step.get(
                        "id"
                    )
                    or ""
                )

                if persisted_id:
                    persisted_by_id[
                        persisted_id
                    ] = persisted_step

            if task_has_failure:
                task["status"] = "failed"

                failed_step = next(
                    (
                        step
                        for step in task_steps
                        if str(
                            step.get("status")
                            or ""
                        ).strip().lower()
                        in failed_statuses
                    ),
                    {},
                )

                task["error"] = str(
                    failed_step.get("error")
                    or failed_step.get("message")
                    or failed_step.get("result")
                    or failed_step.get("output")
                    or "Task execution failed."
                )

            elif task_has_block:
                task["status"] = "blocked"

                blocked_step = next(
                    (
                        step
                        for step in task_steps
                        if str(
                            step.get("status")
                            or ""
                        ).strip().lower()
                        in blocked_statuses
                    ),
                    {},
                )

                task["error"] = str(
                    blocked_step.get("error")
                    or blocked_step.get("message")
                    or blocked_step.get("result")
                    or "Task is blocked."
                )

            elif task_has_waiting:
                task["status"] = "waiting"

            elif task_all_completed:
                task["status"] = "completed"

            else:
                task["status"] = "in_progress"

            if task["status"] == "completed":
                for execution_step in task_steps:
                    if not isinstance(
                        execution_step,
                        dict,
                    ):
                        continue

                    completed_at = (
                        execution_step.get("completed_at")
                        or task.get("completed_at")
                        or datetime.now(
                            timezone.utc
                        ).isoformat()
                    )

                    execution_step.update(
                        {
                            "status": "completed",
                            "completion_status": "completed",
                            "waiting": False,
                            "blocked": False,
                            "error": None,
                            "completed_at": completed_at,
                        }
                    )

                    step_id = str(
                        execution_step.get("id")
                        or ""
                    )

                    persisted_step = persisted_by_id.get(
                        step_id
                    )

                    if isinstance(
                        persisted_step,
                        dict,
                    ):
                        persisted_step.update(
                            {
                                "status": "completed",
                                "completion_status": "completed",
                                "waiting": False,
                                "blocked": False,
                                "error": None,
                                "completed_at": (
                                    persisted_step.get("completed_at")
                                    or completed_at
                                ),
                            }
                        )

                for persisted_step in persisted_steps:
                    if not isinstance(
                        persisted_step,
                        dict,
                    ):
                        continue

                    completed_at = (
                        persisted_step.get("completed_at")
                        or task.get("completed_at")
                        or datetime.now(
                            timezone.utc
                        ).isoformat()
                    )

                    persisted_step.update(
                        {
                            "status": "completed",
                            "completion_status": "completed",
                            "waiting": False,
                            "blocked": False,
                            "error": None,
                            "completed_at": completed_at,
                        }
                    )

            if task_outputs:
                combined_output = "\n\n".join(
                    task_outputs
                )

                task["result"] = combined_output
                task["content"] = combined_output

        if (
            execution_complete
            and all_persisted_steps_completed
        ):

            print(
                "[PROJECT FINALIZE BLOCK ENTERED]",
                "task_count=",
                len(tasks),
                "steps_by_task_count=",
                len(steps_by_task_id),
            )

            completed_task_ids = []
            completed_step_ids = []

            for task in tasks:
                if not isinstance(
                    task,
                    dict,
                ):
                    continue

                task_id = str(
                    task.get("id")
                    or ""
                ).strip()

                if not task_id:
                    continue

                task_steps = steps_by_task_id.get(
                    task_id,
                    [],
                )

                if not task_steps:
                    continue

                current_status = str(
                    task.get("status")
                    or ""
                ).strip().lower()

                if current_status in {
                    "failed",
                    "failure",
                    "error",
                    "errored",
                    "blocked",
                    "cancelled",
                    "canceled",
                }:
                    continue

                normalized_steps = []

                for index, step in enumerate(
                    task_steps
                ):
                    if not isinstance(
                        step,
                        dict,
                    ):
                        continue

                    step_id = str(
                        step.get("id")
                        or f"{task_id}_step_{index + 1}"
                    ).strip()

                    completed_at = (
                        step.get("completed_at")
                        or task.get("completed_at")
                        or datetime.now(
                            timezone.utc
                        ).isoformat()
                    )

                    step.update(
                        {
                            "id": step_id,
                            "status": "completed",
                            "completion_status": "completed",
                            "waiting": False,
                            "blocked": False,
                            "error": None,
                            "completed_at": completed_at,
                        }
                    )

                    normalized_steps.append(
                        step
                    )

                    completed_step_ids.append(
                        step_id
                    )

                if normalized_steps:
                    task["steps"] = normalized_steps

                task["status"] = "completed"

                completed_task_ids.append(
                    task_id
                )

            execution_state = project.get(
                "execution"
            )

            if not isinstance(
                execution_state,
                dict,
            ):
                execution_state = {}

            execution_state["completed_tasks"] = (
                completed_task_ids
            )

            execution_state["completed_steps"] = (
                completed_step_ids
            )

            execution_state["status"] = "completed"
            execution_state["current_phase_id"] = None
            execution_state["current_phase_title"] = None
            execution_state["current_step"] = ""
            execution_state["current_step_index"] = None
            execution_state["current_task_id"] = None
            execution_state["queue"] = []
            execution_state["phase_queue"] = []
            execution_state["updated_at"] = (
                datetime.now(
                    timezone.utc
                ).isoformat()
            )

            project["execution"] = execution_state

        return tasks


    def _publish_completed_artifacts(
        self,
        project_id,
        tasks,
        result,
    ):

        if not isinstance(
            result,
            dict,
        ):
            return []

        execution = (
            result.get("execution")
            or result.get("execution_state")
        )

        # ChatExecutionService.run_all() returns the
        # execution state directly. Support both shapes:
        #
        # 1. {"execution": {"steps": [...]}}
        # 2. {"steps": [...]}
        #
        if not isinstance(
            execution,
            dict,
        ):
            execution = result

        steps = execution.get(
            "steps",
            []
        )

        if not isinstance(
            steps,
            list,
        ):
            steps = []

        task_by_id = {
            str(task.get("id")): task
            for task in tasks
            if isinstance(
                task,
                dict,
            )
            and task.get("id")
        }

        published = []
        published_step_ids = set()
        published_task_ids = set()

        print(
            "[PROJECT ARTIFACT PUBLISH START]",
            {
                "project_id": project_id,
                "task_count": len(tasks),
                "step_count": len(steps),
                "result_keys": list(result.keys()),
                "execution_keys": (
                    list(execution.keys())
                    if isinstance(execution, dict)
                    else []
                ),
            },
            flush=True,
        )

        for step_index, step in enumerate(steps):
            if not isinstance(
                step,
                dict,
            ):
                continue

            status = str(
                step.get(
                    "status",
                    "",
                )
                or ""
            ).strip().lower()

            if status not in {
                "completed",
                "done",
                "success",
            }:
                continue

            task_id = (
                step.get("task_id")
                or step.get("id")
            )

            if not task_id:
                print(
                    "[PROJECT ARTIFACT NO TASK ID]",
                    step,
                    flush=True,
                )
                continue

            task_id = str(task_id)

            if task_id in published_task_ids:
                continue

            published_task_ids.add(
                task_id
            )

            task = task_by_id.get(
                task_id
            )

            if not task:
                print(
                    "[PROJECT ARTIFACT TASK NOT FOUND]",
                    {
                        "task_id": task_id,
                        "available_task_ids": (
                            list(task_by_id.keys())
                        ),
                    },
                    flush=True,
                )
                continue

            print(
                "[PROJECT ARTIFACT STEP DATA]",
                {
                    "task_id": task_id,
                    "step_keys": list(step.keys()),
                    "step": step,
                    "top_level_result_keys": list(result.keys()),
                    "top_level_result": result,
                },
                flush=True,
            )

            artifact_result = (
                step.get("result")
                or step.get("output")
                or step.get("content")
                or step.get("text")
                or result.get("result")
                or result.get("output")
                or result.get("content")
                or ""
            )

            print(
                "[PROJECT ARTIFACT EXTRACTED RESULT]",
                {
                    "task_id": task_id,
                    "artifact_result_type": type(
                        artifact_result
                    ).__name__,
                    "artifact_result": artifact_result,
                    "has_result": bool(artifact_result),
                },
                flush=True,
            )

            artifact = (
                self.artifact_publisher
                .publish_task_artifact(
                    project_id,
                    task,
                    result=artifact_result,
                )
            )

            if artifact:
                published.append(
                    artifact
                )

                published_task_ids.add(
                    task_id
                )

                print(
                    "[PROJECT ARTIFACT PUBLISHED]",
                    {
                        "task_id": task_id,
                        "artifact": artifact.get("name")
                        or artifact.get("original_name")
                        or artifact.get("id"),
                    },
                    flush=True,
                )
            else:
                print(
                    "[PROJECT ARTIFACT NOT CREATED]",
                    {
                        "task_id": task_id,
                        "target_file": task.get(
                            "target_file"
                        ),
                        "has_result": bool(
                            artifact_result
                        ),
                    },
                    flush=True,
                )

        return published

    def _sync_project_execution(
        self,
        project_id,
        result,
        action,
        tasks=None,
    ):
        if not isinstance(
            result,
            dict,
        ):
            return

        tasks = tasks or []

        execution = (
            result.get(
                "execution"
            )
            or result.get(
                "execution_state"
            )
        )

        if not isinstance(
            execution,
            dict,
        ):
            if isinstance(
                result.get(
                    "steps"
                ),
                list,
            ):
                execution = result
            else:
                return

        steps = execution.get(
            "steps",
            [],
        )

        if not isinstance(
            steps,
            list,
        ):
            steps = []

        if not steps:
            steps = [
                {
                    "task_id": task.get("id"),
                    "id": task.get("id"),
                    "status": task.get("status"),
                    "result": (
                        task.get("result")
                        or task.get("output")
                        or task.get("content")
                        or task.get("response")
                        or ""
                    ),
                }
                for task in tasks
                if isinstance(
                    task,
                    dict,
                )
                and str(
                    task.get("status") or ""
                ).strip().lower()
                in {
                    "completed",
                    "complete",
                    "done",
                    "success",
                }
            ]

            print(
                "[PROJECT ARTIFACT FALLBACK STEPS]",
                {
                    "project_id": project_id,
                    "step_count": len(steps),
                },
                flush=True,
            )

        project = self._get_project(
            project_id
        )

        if not project:
            return

        # Sync execution-service task results back into
        # the persistent project task list.

        # Apply parent-task status only after evaluating the complete
        # execution and every nested execution step.

        execution_status = str(
            execution.get(
                "status",
                "",
            )
        ).strip().lower()

        execution_complete = bool(
            execution.get(
                "complete"
            )
        )

        execution_steps = execution.get(
            "steps"
        )

        if not isinstance(
            execution_steps,
            list,
        ):
            execution_steps = []

        execution_step_statuses = [
            str(
                execution_step.get(
                    "status",
                    "",
                )
            ).strip().lower()
            for execution_step in execution_steps
            if isinstance(
                execution_step,
                dict,
            )
        ]

        completed_statuses = {
            "completed",
            "complete",
            "done",
            "success",
            "succeeded",
        }

        all_execution_steps_completed = (
            bool(execution_step_statuses)
            and all(
                status in completed_statuses
                for status in execution_step_statuses
            )
        )

        parent_execution_is_complete = (
            execution_status in completed_statuses
            and execution_complete
            and all_execution_steps_completed
        )

        if parent_execution_is_complete:
            completed_task_id = execution.get(
                "task_id"
            ) or execution.get(
                "current_task_id"
            )

            if completed_task_id:
                self.project_workspace_service.update_task_status(
                    project_id,
                    completed_task_id,
                    "completed",
                )
        elif execution_status in {
            "running",
            "in_progress",
            "processing",
            "pending",
            "waiting",
        }:
            active_task_id = execution.get(
                "task_id"
            ) or execution.get(
                "current_task_id"
            )

            if active_task_id:
                self.project_workspace_service.update_task_status(
                    project_id,
                    active_task_id,
                    "in_progress",
                )

        #
        # IMPORTANT:
        # Each item in "steps" represents an individual execution step.
        # A completed individual step must never mark the entire parent
        # task as completed while other nested steps are still active.

        completed_statuses = {
            "completed",
            "complete",
            "done",
            "success",
            "succeeded",
        }

        active_statuses = {
            "active",
            "running",
            "in_progress",
            "processing",
            "pending",
            "waiting",
            "blocked",
        }

        for step in steps:
            if not isinstance(
                step,
                dict,
            ):
                continue

            task_id = (
                step.get(
                    "task_id"
                )
                or step.get(
                    "id"
                )
            )

            if not task_id:
                continue

            status = str(
                step.get(
                    "status",
                    "",
                )
            ).strip().lower()

            print(
                "[PROJECT SYNC STEP]",
                {
                    "task_id": task_id,
                    "status": status,
                    "step_id": step.get("id"),
                    "error": step.get("error"),
                    "result": step.get("result"),
                },
                flush=True,
            )

            # Individual step failure takes priority.
            if status == "failed":
                self.project_workspace_service.update_task_status(
                    project_id,
                    task_id,
                    "failed",
                )
                continue

            # Individual step blocking takes priority.
            if status == "blocked":
                self.project_workspace_service.update_task_status(
                    project_id,
                    task_id,
                    "blocked",
                )
                continue

            # A completed step does not prove that the parent task
            # is complete. Parent completion is evaluated below using
            # the full execution state and all nested step statuses.
            if status in completed_statuses:
                continue

            # Any active, waiting, pending, or otherwise incomplete
            # step keeps the parent task in progress.
            if status in active_statuses:
                self.project_workspace_service.update_task_status(
                    project_id,
                    task_id,
                    "in_progress",
                )
                continue

            # Unknown or empty statuses are treated conservatively
            # as incomplete rather than completed.
            self.project_workspace_service.update_task_status(
                project_id,
                task_id,
                "in_progress",
            )


        # IMPORTANT:
        # Always reload the project AFTER task status changes.
        # The project-level state must be based on the actual
        # remaining project tasks, not on the execution-service
        # status of the single task that just ran.
        project = self._get_project(
            project_id
        ) or {}

        latest_tasks = self._get_tasks(
            project
        )

        remaining_tasks = self._phase_aware_runnable_tasks(
            project,
            latest_tasks,
        )

        execution_status = str(
            execution.get(
                "status",
                "",
            )
        ).strip().lower()

        print(
            "[PROJECT SYNC DECISION]",
            {
                "project_id": project_id,
                "execution_status": execution_status,
                "remaining_tasks": len(remaining_tasks),
                "remaining_ids": [
                    task.get("id")
                    for task in remaining_tasks
                    if isinstance(
                        task,
                        dict,
                    )
                    and task.get("id")
                ],
                "action": action,
            },
            flush=True,
        )

        # A genuine failed/blocked execution stops the project.
        if execution_status in {
            "failed",
            "blocked",
        }:
            queue = [
                task.get("id")
                for task in remaining_tasks
                if isinstance(
                    task,
                    dict,
                )
                and task.get("id")
            ]

            next_task = (
                remaining_tasks[0]
                if remaining_tasks
                else None
            )

            execution = (
                self.project_workspace_service.update_execution_state(
                    project_id,
                    status=execution_status,
                    current_task_id=(
                        next_task.get("id")
                        if next_task
                        else None
                    ),
                    current_step=(
                        next_task.get(
                            "title",
                            "",
                        )
                        if next_task
                        else ""
                    ),
                    queue=queue,
                    last_action=action,
                )
            )

            projects = (
                self.project_workspace_service._load_projects()
            )

            for project in projects:
                if (
                    project.get("id") != project_id
                    or not self.project_workspace_service._same_project_owner(
                        project
                    )
                ):
                    continue

                project["status"] = execution_status
                project["active"] = False
                project["updated_at"] = (
                    execution.get(
                        "updated_at"
                    )
                    if isinstance(
                        execution,
                        dict,
                    )
                    else project.get(
                        "updated_at"
                    )
                )

                self.project_workspace_service._save_projects(
                    projects
                )
                break

            return

        # Approval is a project pause, not completion.
        if execution_status == "waiting_approval":
            queue = [
                task.get("id")
                for task in remaining_tasks
                if isinstance(
                    task,
                    dict,
                )
                and task.get("id")
            ]

            next_task = (
                remaining_tasks[0]
                if remaining_tasks
                else None
            )

            self.project_workspace_service.update_execution_state(
                project_id,
                status="paused",
                current_task_id=(
                    next_task.get("id")
                    if next_task
                    else None
                ),
                current_step=(
                    next_task.get(
                        "title",
                        "",
                    )
                    if next_task
                    else ""
                ),
                queue=queue,
                last_action=action,
            )

            return

        # CRITICAL RUN-ALL RULE:
        #
        # The execution service runs ONE project task at a time.
        # Therefore execution_status == "complete" only means
        # that the CURRENT execution finished.
        #
        # It does NOT mean the entire project is complete.
        #
        # Only zero runnable project tasks means the project
        # itself is complete.
        if remaining_tasks:
            next_task = remaining_tasks[0]

            queue = [
                task.get("id")
                for task in remaining_tasks
                if isinstance(
                    task,
                    dict,
                )
                and task.get("id")
            ]

            print(
                "[PROJECT SYNC CONTINUE]",
                {
                    "project_id": project_id,
                    "next_task_id": next_task.get("id"),
                    "remaining": len(remaining_tasks),
                },
                flush=True,
            )

            self.project_workspace_service.update_execution_state(
                project_id,
                status="running",
                current_task_id=next_task.get(
                    "id"
                ),
                current_step=next_task.get(
                    "title",
                    "",
                ),
                queue=queue,
                last_action=action,
            )

            return

        # No runnable tasks remain.
        # Completion is valid only when every project task
        # has a terminal success status.
        terminal_success_statuses = {
            "completed",
            "complete",
            "done",
            "success",
        }

        task_statuses = [
            str(
                task.get(
                    "status",
                    "",
                )
            ).strip().lower()
            for task in latest_tasks
            if isinstance(
                task,
                dict,
            )
        ]

        all_tasks_completed = bool(
            task_statuses
        ) and all(
            status in terminal_success_statuses
            for status in task_statuses
        )

        print(
            "[PROJECT SYNC FINAL DECISION]",
            {
                "project_id": project_id,
                "remaining": 0,
                "task_statuses": task_statuses,
                "all_tasks_completed": all_tasks_completed,
            },
            flush=True,
        )

        if all_tasks_completed:
            self.project_workspace_service.update_execution_state(
                project_id,
                status="completed",
                current_task_id=None,
                current_step="",
                queue=[],
                last_action=action,
            )

        else:
            # No runnable tasks remain, but the project is not
            # successfully complete. Preserve the actual task
            # failure/block state instead of falsely completing.
            unresolved_statuses = [
                status
                for status in task_statuses
                if status not in terminal_success_statuses
            ]

            print(
                "[PROJECT SYNC NOT COMPLETE]",
                {
                    "project_id": project_id,
                    "unresolved_statuses": unresolved_statuses,
                },
                flush=True,
            )

            current_execution = (
                self.project_workspace_service.get_execution_state(
                    project_id
                )
                or {}
            )

            current_execution_status = str(
                current_execution.get(
                    "status",
                    "",
                )
            ).strip().lower()

            if current_execution_status not in {
                "failed",
                "blocked",
                "paused",
            }:
                self.project_workspace_service.update_execution_state(
                    project_id,
                    status="paused",
                    current_task_id=None,
                    current_step="",
                    queue=[],
                    last_action=action,
                )

        # Recalculate phase statuses after all task statuses have
        # been persisted. This must happen before the final project
        # record is saved.
        try:
            self._sync_phase_statuses(project_id)
        except Exception as phase_sync_error:
            print(
                "[PROJECT FINAL PHASE STATUS SYNC ERROR]",
                repr(phase_sync_error),
                flush=True,
            )

        # Persist the top-level project status consistently with the
        # final execution-state decision. Never force completion here.
        projects = (
            self.project_workspace_service._load_projects()
        )

        for project in projects:
            if project.get("id") != project_id:
                continue

            execution_state = (
                self.project_workspace_service.get_execution_state(
                    project_id
                )
                or {}
            )

            persisted_execution_status = str(
                execution_state.get(
                    "status",
                    "",
                )
            ).strip().lower()

            if persisted_execution_status == "completed":
                project["status"] = "completed"
                project["active"] = False

            elif persisted_execution_status == "failed":
                project["status"] = "failed"
                project["active"] = False

            elif persisted_execution_status == "blocked":
                project["status"] = "blocked"
                project["active"] = False

            elif persisted_execution_status == "paused":
                project["status"] = "paused"
                project["active"] = False

            elif persisted_execution_status == "stopped":
                project["status"] = "stopped"
                project["active"] = False

            else:
                project["status"] = "active"
                project["active"] = True

            project["updated_at"] = datetime.now(
                timezone.utc
            ).isoformat()

            self.project_workspace_service._save_projects(
                projects
            )
            break


    def pause_project(
        self,
        project_id,
    ):
        project = self._get_project(
            project_id
        )

        if not project:
            return None

        execution = (
            self.project_workspace_service
            .get_execution_state(
                project_id
            )
            or {}
        )

        updated = (
            self.project_workspace_service
            .update_execution_state(
                project_id,
                status="paused",
